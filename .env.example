# Required for A2A message/task methods (not required for --card)
SUWAPPU_API_KEY=suwappu_sk_your_api_key_here

# Optional endpoint overrides
# SUWAPPU_A2A_URL=https://api.suwappu.bot/a2a
# SUWAPPU_AGENT_CARD_URL=https://api.suwappu.bot/.well-known/agent.json

# Optional polling timeout for asynchronous A2A tasks
# SUWAPPU_A2A_POLL_TIMEOUT_MS=120000
